#!/bin/sh
set -eu

kernel_mode=0
if [ "${1:-}" = "--kernel" ]; then
    kernel_mode=1
    shift
fi
if [ "$#" -eq 0 ]; then
    echo "usage: wsl-win-relay-run [--kernel] COMMAND [ARG ...]" >&2
    exit 2
fi

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
library=${WSL_WIN_RELAY_PRELOAD:-"$repo_dir/lib/libwsl_win_relay_listen.so"}
kernel_supervisor=${WSL_WIN_RELAY_KERNEL_SUPERVISOR:-"$repo_dir/bin/wsl-win-relay-strict"}
control=${WSL_WIN_RELAY_CONTROL:-/tmp/wsl-win-relay-control.sock}
retry_seconds=${WSL_WIN_RELAY_CONTROL_RETRY_SECONDS:-2}
case "$retry_seconds" in
    ''|*[!0-9]*) retry_seconds=2 ;;
esac
if [ "$retry_seconds" -gt 60 ]; then
    retry_seconds=60
fi
retry_attempts=$((retry_seconds * 10 + 1))

if [ "$kernel_mode" -eq 1 ]; then
    if [ ! -x "$kernel_supervisor" ]; then
        echo "kernel strict supervisor not found: $kernel_supervisor (run scripts/build-wsl.sh)" >&2
        exit 1
    fi
    kernel_target=$1
    case "$kernel_target" in
        */*) kernel_target_path=$kernel_target ;;
        *) kernel_target_path=$(command -v "$kernel_target" 2>/dev/null || true) ;;
    esac
    if [ -f "$kernel_target_path" ]; then
        kernel_permissions=$(stat -c '%A' "$kernel_target_path" 2>/dev/null || stat -f '%Sp' "$kernel_target_path" 2>/dev/null || true)
        case "$kernel_permissions" in
            *s*)
                echo "kernel strict supervisor refuses setuid/setgid target: $kernel_target_path" >&2
                exit 1
                ;;
        esac
    fi
    unset LD_PRELOAD
    export WSL_WIN_RELAY_CONTROL=$control
    exec "$kernel_supervisor" "$@"
fi

if [ ! -r "$library" ]; then
    echo "listen interposer not found: $library (run scripts/build-wsl.sh)" >&2
    exit 1
fi

resolve_target_path() {
    target=$1
    case "$target" in
        */*) printf '%s\n' "$target" ;;
        *) command -v "$target" 2>/dev/null || true ;;
    esac
}

validate_target_support() {
    target_path=$(resolve_target_path "$1")
    [ -f "$target_path" ] || return 0
    permissions=$(stat -c '%A' "$target_path" 2>/dev/null || stat -f '%Sp' "$target_path" 2>/dev/null || true)
    case "$permissions" in
        *s*)
            echo "strict listener interposition refuses setuid/setgid target: $target_path" >&2
            return 1
            ;;
    esac
    if ! command -v readelf >/dev/null 2>&1; then
        return 0
    fi
    if readelf -h "$target_path" 2>/dev/null | grep -q '^ELF'; then
        if ! readelf -l "$target_path" 2>/dev/null | grep -q 'INTERP'; then
            echo "strict listener interposition requires a dynamically linked ELF target: $target_path" >&2
            return 1
        fi
    fi
}

validate_target_support "$1"

for _ in $(seq 1 "$retry_attempts"); do
    [ -S "$control" ] && break
    sleep 0.1
done
if [ ! -S "$control" ]; then
    echo "strict listener control socket is unavailable: $control (start wsl-proxy-linux first)" >&2
    exit 1
fi

export WSL_WIN_RELAY_CONTROL=$control
if [ -n "${LD_PRELOAD:-}" ]; then
    export LD_PRELOAD="$library:$LD_PRELOAD"
else
    export LD_PRELOAD=$library
fi
exec "$@"
