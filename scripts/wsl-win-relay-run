#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: wsl-win-relay-run COMMAND [ARG ...]" >&2
    exit 2
fi

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
library=${WSL_WIN_RELAY_PRELOAD:-"$repo_dir/lib/libwsl_win_relay_listen.so"}
control=${WSL_WIN_RELAY_CONTROL:-/tmp/wsl-win-relay-control.sock}
retry_seconds=${WSL_WIN_RELAY_CONTROL_RETRY_SECONDS:-2}
case "$retry_seconds" in
    ''|*[!0-9]*) retry_seconds=2 ;;
esac
if [ "$retry_seconds" -gt 60 ]; then
    retry_seconds=60
fi
retry_attempts=$((retry_seconds * 10 + 1))

if [ ! -r "$library" ]; then
    echo "listen interposer not found: $library (run scripts/build-wsl.sh)" >&2
    exit 1
fi

for _ in $(seq 1 "$retry_attempts"); do
    [ -S "$control" ] && break
    sleep 0.1
done
if [ ! -S "$control" ]; then
    echo "strict listener control socket is unavailable: $control (start wsl-proxy-linux first)" >&2
    exit 1
fi

export WSL_WIN_RELAY_CONTROL=$control
if [ -n "${LD_PRELOAD:-}" ]; then
    export LD_PRELOAD="$library:$LD_PRELOAD"
else
    export LD_PRELOAD=$library
fi
exec "$@"
