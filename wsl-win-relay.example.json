    "windows_port_offset": 0,
    "windows_port_auto": false,
    "status_file": "",
    "interval": "1s",
    "retry_min": "1s",
    "retry_max": "30s",
    "include": [],
    "udp_include": [],
    "exclude": [22, 53]
  }
