[Unit]
Description=WSL to Windows persistent relay broker
After=default.target

[Service]
Type=simple
ExecStart=%h/bin/wsl-win-relay-broker-service
Restart=on-failure
RestartSec=2s
# The service wrapper starts the broker's host supervisor; keep the role tree
# alive when systemd restarts that wrapper.
# A normal stop cascades STOP through their private control endpoints.
KillMode=process
TimeoutStopSec=10s

[Install]
WantedBy=default.target
