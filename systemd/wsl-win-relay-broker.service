[Unit]
Description=WSL to Windows persistent relay broker
After=default.target

[Service]
Type=simple
ExecStart=%h/bin/wsl-win-relay-broker-service
Restart=on-failure
RestartSec=2s
# Keep the bridge worker and socket host alive when systemd restarts a crashed frontend.
# A normal stop cascades STOP through their private control endpoints.
KillMode=process
TimeoutStopSec=10s

[Install]
WantedBy=default.target
