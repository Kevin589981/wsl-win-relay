[Unit]
Description=WSL to Windows persistent relay broker
After=default.target

[Service]
Type=simple
ExecStart=%h/bin/wsl-win-relay-broker-service
Restart=on-failure
RestartSec=2s
# Keep the socket-owning worker alive when systemd restarts a crashed frontend.
# A normal frontend stop sends STOP through the private worker control endpoint.
KillMode=process
TimeoutStopSec=10s

[Install]
WantedBy=default.target
